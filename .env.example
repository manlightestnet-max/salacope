# Salacope: environment variables (Vercel > Settings > Environment Variables; .env.local for development).
# Never commit real values.

# --- Database (Neon). Dev and production are two different databases.
# The live site (Vercel production) reads SALACOPE_DATABASE_URL_PRODUCTION only; previews and local work read SALACOPE_DATABASE_URL.
SALACOPE_DATABASE_URL=postgresql://user:password@host/salacope_sandbox?sslmode=require
SALACOPE_DATABASE_URL_PRODUCTION=postgresql://user:password@host/salacope?sslmode=require

# --- Accounts (Firebase, same project as LightPay)
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Firebase uids of the administrators, comma separated.
SALACOPE_ADMIN_UIDS=

# --- Payments (LightPay). LIGHTWALLET_ENV picks the key: sandbox (test money) or production.
LIGHTWALLET_ENV=sandbox
LIGHTWALLET_APP_ID=salacope
LIGHTWALLET_SECRET_KEY_SANDBOX=
LIGHTWALLET_SECRET_KEY_PRODUCTION=
LIGHTWALLET_WEBHOOK_SECRET=
# Optional overrides
LIGHTWALLET_API_URL=
LIGHTPAY_CHECKOUT_URL=
VITE_LIGHTPAY_CHECKOUT_URL=

# --- Site
# Public origin used in links and previews, e.g. https://salacope.online
SALACOPE_PUBLIC_URL=
# Secret the daily payout job (Vercel cron) sends.
CRON_SECRET=

# --- Settings encryption (32 random bytes, base64). Encrypts the R2 keys saved in Admin > Stockage. Never change it afterwards.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SALACOPE_SETTINGS_KEY=

# --- Emergency brake
# Optional. Forces a level whatever the administration says: payments | readonly | total (total = nothing touches the database).
SALACOPE_LOCKDOWN=
# Optional. When set, lifting the brake from Admin > Securite asks for this code.
SALACOPE_UNLOCK_CODE=

# --- Tests only: points the storage client at a local S3 emulator
SALACOPE_R2_ENDPOINT=
