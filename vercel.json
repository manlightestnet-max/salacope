{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://lightpay-a5f01.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://lightpay-a5f01.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    },
    {
      "source": "/p/:id",
      "destination": "/api?__path=/share/p/:id"
    },
    {
      "source": "/s/:id",
      "destination": "/api?__path=/share/s/:id"
    },
    {
      "source": "/@:handle",
      "destination": "/api?__path=/share/h/:handle"
    },
    {
      "source": "/ac/p/:id",
      "destination": "/api?__path=/share/p/:id"
    },
    {
      "source": "/ac/s/:id",
      "destination": "/api?__path=/share/s/:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__path=/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/api?__path=/share/home"
    },
    {
      "source": "/llms.txt",
      "destination": "/api?__path=/llms.txt"
    },
    {
      "source": "/((?!api/|api$|__/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/settle",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
